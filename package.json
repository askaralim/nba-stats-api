{
  "name": "nba-stats-api",
  "version": "1.0.0",
  "description": "NBA Stats API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "node scripts/run-migrations.js",
    "migrate:league-seasons": "node scripts/run-single-migration.js migrations/004_create_league_seasons.sql",
    "migrate:teams": "node scripts/run-single-migration.js migrations/005_teams.sql",
    "migrate:player-leaders": "node scripts/run-single-migration.js migrations/007_player_leaders.sql",
    "migrate:standings": "node scripts/run-single-migration.js migrations/006_standings_entries.sql",
    "capture-espn-samples": "node scripts/capture-espn-samples.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "nba",
    "stats",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@sentry/node": "^10.50.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "compression": "^1.7.4",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^24.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^15.15.0",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
